# ESG Copilot - Environment Variables
# Copy this file to .env and fill in your API keys

# ===== Auth0 Configuration (REQUIRED) =====
AUTH0_DOMAIN=your_auth0_domain.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_API_IDENTIFIER=https://api.esg-copilot.com
AUTH0_AUDIENCE=https://api.esg-copilot.com
AUTH0_CALLBACK_URL=http://localhost:8000/callback

# ===== Google Cloud Configuration (REQUIRED) =====
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=.secrets/service-account.json
DATASET_ID=esg_copilot_data
CLOUD_PROJECT_REGION=us-central1

# ===== Pub/Sub Configuration (REQUIRED for agent communication) =====
PUBSUB_TOPIC=agent-messages
PUBSUB_SUBSCRIPTION=agent-messages-sub

# ===== Gemini AI Configuration (REQUIRED) =====
GOOGLE_API_KEY=your_google_api_key_here
MODEL=gemini-2.5-flash
TEMPERATURE=0.2
TOP_P=0.95
TOP_K=40

# ===== Report Generation Configuration =====
# Max review iterations (1-3): Set to 1 for testing, 3 for production
MAX_REVIEW_ITERATIONS=1
# Report refinement iterations (1-3): Set to 1 for testing, 3 for production
REPORT_REFINEMENT_ITERATIONS=1

# ===== Google Maps API (REQUIRED for Company Discovery) =====
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ===== SendGrid Configuration (REQUIRED for Outreach Agent) =====
# ⚠️ Store API key in Auth0 Token Vault for production
SENDGRID_FROM_EMAIL=your_email@example.com
FRONTEND_URL=http://localhost:3000

# ===== Climatiq API (REQUIRED for Emissions Calculator) =====
# ⚠️ Store API key in Auth0 Token Vault for production
CLIMATIQ_API_KEY=your_climatiq_api_key_here

# ===== Pinecone API (REQUIRED for RAG/Chat) =====
# ⚠️ Store API key in Auth0 Token Vault for production
PINECONE_API_KEY=your_pinecone_api_key_here

# ===== Auth0 FGA (Fine-Grained Authorization) - OPTIONAL =====
# For document-level access control in RAG pipelines
# Get these from: https://dashboard.fga.dev/
FGA_API_URL=https://api.us1.fga.dev
FGA_STORE_ID=your_fga_store_id_here
FGA_MODEL_ID=your_fga_model_id_here
FGA_API_TOKEN_ISSUER=auth.fga.dev
FGA_API_AUDIENCE=https://api.us1.fga.dev/
FGA_CLIENT_ID=your_fga_client_id_here
FGA_CLIENT_SECRET=your_fga_client_secret_here

# ===== Government APIs (FREE - No keys needed) =====
EPA_API_BASE_URL=https://data.epa.gov/efservice
OSHA_API_BASE_URL=https://data.osha.gov/odi/v1

# ===== NOT CURRENTLY USED =====
# COMPANIES_HOUSE_API_KEY=your_companies_house_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
