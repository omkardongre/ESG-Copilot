# ===== Auth0 Configuration (REQUIRED) =====
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_API_IDENTIFIER=
AUTH0_AUDIENCE=

# ===== Google Cloud & BigQuery (REQUIRED) =====
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
DATASET_ID=
CLOUD_PROJECT_REGION=

# ===== Gemini AI (REQUIRED) =====
GOOGLE_API_KEY=
MODEL=gemini-2.5-flash
TEMPERATURE=0.2
TOP_P=0.95
TOP_K=40

# ===== Report Generation Configuration =====
MAX_REVIEW_ITERATIONS=1
REPORT_REFINEMENT_ITERATIONS=1

# ===== SendGrid (REQUIRED) =====
SENDGRID_FROM_EMAIL=
FRONTEND_URL=

# ===== Climatiq API (REQUIRED) =====
CLIMATIQ_API_KEY=

# ===== Pinecone API (REQUIRED) =====
PINECONE_API_KEY=

# ===== Auth0 FGA Store (REQUIRED for document-level authorization) =====
FGA_API_URL=
FGA_STORE_ID=
FGA_MODEL_ID=
FGA_API_TOKEN_ISSUER=
FGA_API_AUDIENCE=
FGA_CLIENT_ID=
FGA_CLIENT_SECRET=

