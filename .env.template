# ESG Copilot Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=8000
NODE_ENV=development

# Auth0 (REQUIRED - Get from https://auth0.com)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_API_IDENTIFIER=https://api.esg-copilot.com

# Google Cloud (REQUIRED)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=.secrets/service-account.json
DATASET_ID=esg_copilot_data

# Gemini AI (REQUIRED - Get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=AIzaSy...your_key_here
MODEL=gemini-2.0-flash-exp
TEMPERATURE=0.2

# Email (REQUIRED for F3 outreach)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
FROM_EMAIL=your_email@gmail.com

# Service Ports
COMPANY_FINDER_PORT=8081
COMPLIANCE_MANAGER_PORT=8082
ESG_RESEARCH_AGENT_PORT=8084
REPORT_GENERATOR_PORT=8085

# Company Data API (Optional)
COMPANIES_HOUSE_API_KEY=your_companies_house_key_here

# EPA API (Optional - Free, no key required for basic access)
EPA_API_KEY=

# Climatiq Carbon API (Optional)
CLIMATIQ_API_KEY=your_climatiq_key_here
